# Reel worker env. Copy to worker/.env for local runs (gitignored);
# in production these are GitHub repo secrets (Settings → Secrets → Actions).
#
# MODE picks what a run does: "process" (default) drains the queue and writes
# results with NO email; "digest" sends one email of everything not yet reported.
# The reel-process workflow sets MODE=process, reel-digest sets MODE=digest.
# MODE=process

# ── Supabase (service_role bypasses RLS — server-side ONLY, never in frontend) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── NVIDIA build.nvidia.com (LLM classify/structure + VLM on-screen text) ──
# One API key (nvapi-...) from https://build.nvidia.com (Get API Key).
# NOTE: NVIDIA's hosted ASR is gRPC-only, so transcription runs on Groq (below),
# not NVIDIA. NVIDIA here does only the LLM + vision.
NVIDIA_API_KEY=
# Optional model overrides (defaults in config.mjs):
# NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

# ── Transcription: Groq Whisper (OpenAI-compatible REST) ──
# Key from https://console.groq.com. Swap providers via ASR_BASE + ASR_MODEL.
GROQ_API_KEY=
# ASR_BASE=https://api.groq.com/openai/v1
# ASR_MODEL=whisper-large-v3

# ── Instagram resolver (RapidAPI) ──
# Using "Instagram Downloader..." by Kk Creation (GET ?url=). Verified real (not a
# mock) on 2026-07-24. URL_TEMPLATE must contain {url} where the reel link goes.
# NOTE: this provider returns no caption; the pipeline runs on transcript + OCR.
#
# Free tier = ~45 reels/month PER account key. Make more RapidAPI accounts (any
# email), subscribe each to the SAME API, and list all their keys comma-separated
# in RAPIDAPI_KEYS — the worker burns one dry, rolls to the next, and emails you
# when they're all spent. RAPIDAPI_KEY (single) still works as a fallback.
RAPIDAPI_KEYS=key1,key2,key3
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-downloader-download-instagram-stories-videos4.p.rapidapi.com
RAPIDAPI_URL_TEMPLATE=https://instagram-downloader-download-instagram-stories-videos4.p.rapidapi.com/convert?url={url}

# ── Email (Resend — reuse the portal's key + verified sender) ──
RESEND_API_KEY=
RESEND_FROM=
OWNER_EMAIL=

# ── App ──
APP_URL=

# ── Optional guardrails ──
# MAX_ITEMS_PER_RUN=50
# FRAME_COUNT=3

# Moonshot (Kimi), direct. kimi-k3 scored 100% on the Comprehension Test and is
# multimodal, so it backs BOTH the text steps and OCR. Previously reachable only
# through NVIDIA, whose key now 401s on inference.
KIMI_API_KEY=
